{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-schema.dev/schema/component.schema.json",
  "title": "Component frontmatter",
  "description": "Machine-readable half of a component doc. Lives under the `component:` key of the Markdown frontmatter. Derived from schema/component.ts by tools/schema.ts — do not edit by hand.",
  "type": "object",
  "properties": {
    "component": {
      "$ref": "#/$defs/componentDef"
    }
  },
  "required": [
    "component"
  ],
  "$defs": {
    "componentDef": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "category": {
          "type": "string",
          "enum": [
            "action",
            "typography",
            "input",
            "layout",
            "feedback",
            "navigation",
            "container",
            "overlay",
            "data",
            "primitive"
          ]
        },
        "status": {
          "default": "draft",
          "type": "string",
          "enum": [
            "draft",
            "review",
            "stable",
            "deprecated"
          ]
        },
        "apg": {
          "description": "Slug of the W3C ARIA Authoring Practices pattern this component implements, e.g. 'dialog-modal'. Behavior follows the APG when systems disagree.",
          "type": "string",
          "enum": [
            "accordion",
            "alert",
            "alertdialog",
            "breadcrumb",
            "button",
            "carousel",
            "checkbox",
            "combobox",
            "dialog-modal",
            "disclosure",
            "feed",
            "grid",
            "landmarks",
            "link",
            "listbox",
            "menubar",
            "menu-button",
            "meter",
            "radio",
            "slider",
            "slider-multithumb",
            "spinbutton",
            "switch",
            "table",
            "tabs",
            "toolbar",
            "tooltip",
            "treeview",
            "treegrid",
            "windowsplitter"
          ]
        },
        "anatomy": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "props": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/propDef"
          }
        },
        "events": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/eventDef"
          }
        },
        "styles": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/styleBinding"
          }
        },
        "a11y": {
          "$ref": "#/$defs/a11yDef"
        },
        "keyboard": {
          "description": "The keyboard model, key → action, taken from the APG pattern. Generators implement every rule; the planned keyboard gate presses every key and checks the action.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/keyboardRule"
          }
        },
        "composition": {
          "description": "Anatomy part → the system component it MUST be built from (closeButton: Button, title: Heading). Parts not listed are plain elements. The parser checks the component exists or is marked (planned).",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "behavior": {
          "description": "Authored given/when/then scenarios the behavior gate turns into tests on every platform. Schema-derived scenarios (renders, accessible name, focusable, error identified, one per enum value) are added by the parser; author only what the schema cannot infer.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/behaviorScenario"
          }
        },
        "copy": {
          "description": "User-facing strings the component renders itself (validation messages, summary headings). Templates may use {label}, {count}. Generators must use these verbatim so copy is consistent across platforms and localizable in one place.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "platforms": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/platformId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/platformNotes"
          }
        }
      },
      "required": [
        "name",
        "category",
        "anatomy",
        "props",
        "a11y",
        "platforms"
      ],
      "additionalProperties": false
    },
    "propDef": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "enum",
            "content",
            "array",
            "object",
            "function",
            "union"
          ],
          "description": "A value of more than one kind (a single id or an array of them) is 'union', with the kinds spelled out in shape."
        },
        "description": {
          "type": "string"
        },
        "shape": {
          "description": "For array/object/function/union props: the item or field shape in TypeScript-like notation, e.g. '{ value: string; label: string; description?: string; disabled?: boolean }[]' or 'string | string[]'. Required for union.",
          "type": "string"
        },
        "required": {
          "default": false,
          "type": "boolean"
        },
        "default": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "a11y": {
          "type": "string"
        },
        "a11yRole": {
          "description": "What this prop contributes to the accessibility tree.",
          "type": "string",
          "enum": [
            "accessible-name",
            "description",
            "error"
          ]
        },
        "platforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/platformId"
          }
        },
        "source": {
          "description": "Set by the parser: the extension doc that added this item, e.g. extensions/Button.analytics.md. Never authored.",
          "type": "string"
        }
      },
      "required": [
        "type",
        "description"
      ],
      "additionalProperties": false
    },
    "platformId": {
      "type": "string",
      "enum": [
        "web",
        "lit",
        "rn",
        "swiftui"
      ]
    },
    "eventDef": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "gesture": {
          "default": false,
          "description": "True when the natural trigger is a touch gesture (swipe, drag, long-press). Components declaring a gesture event must also list gesture-alternative in a11y.requires.",
          "type": "boolean"
        },
        "platforms": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/platformId"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "source": {
          "description": "Set by the parser: the extension doc that added this item, e.g. extensions/Button.analytics.md. Never authored.",
          "type": "string"
        }
      },
      "required": [
        "description",
        "platforms"
      ],
      "additionalProperties": false
    },
    "styleBinding": {
      "type": "object",
      "properties": {
        "token": {
          "$ref": "#/$defs/tokenRef"
        },
        "description": {
          "type": "string"
        },
        "locked": {
          "default": false,
          "description": "Not overridable per instance. The parser locks a binding automatically when (1) its token is a focus-indicator or target-size token (color.border.focus, color.inverse.focus, border.width.focus, size.target.*), (2) its token appears in an a11y.contrast pair, literally or after expanding {slot} interpolation over the enum values, or (3) its name starts with focusRing or is minTarget or dismissTarget. Setting locked: false on such a binding is an error; set locked: true for others (e.g. a size that keeps a target reachable).",
          "type": "boolean"
        },
        "source": {
          "description": "Set by the parser: the extension doc that added this item, e.g. extensions/Button.analytics.md. Never authored.",
          "type": "string"
        }
      },
      "required": [
        "token"
      ],
      "additionalProperties": false
    },
    "tokenRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.(\\{[a-zA-Z]+\\}|[a-zA-Z0-9-]+))+$",
      "description": "Dotted token path, e.g. color.foreground.strong. Braces interpolate a prop value: space.{size}."
    },
    "a11yDef": {
      "type": "object",
      "properties": {
        "role": {
          "description": "The WAI-ARIA 1.2 role the component root renders (none or presentation when it adds nothing). Exactly one of role and roleFrom.",
          "$ref": "#/$defs/ariaRole"
        },
        "roleFrom": {
          "description": "the enum prop whose value is the rendered role",
          "type": "string"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "accessible-name",
              "focus-visible",
              "keyboard-operable",
              "target-24px",
              "target-44px",
              "contrast-aa",
              "contrast-aaa",
              "heading-hierarchy",
              "label-association",
              "error-identification",
              "focus-trap",
              "focus-restore",
              "escape-dismiss",
              "arrow-navigation",
              "roving-tabindex",
              "expanded-state",
              "selected-state",
              "live-region",
              "reduced-motion",
              "gesture-alternative",
              "landmark-role",
              "inert-background",
              "scroll-lock",
              "no-hover-only"
            ]
          }
        },
        "contrast": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contrastPair"
          }
        }
      },
      "required": [
        "requires"
      ],
      "additionalProperties": false
    },
    "ariaRole": {
      "type": "string",
      "enum": [
        "button",
        "checkbox",
        "gridcell",
        "link",
        "menuitem",
        "menuitemcheckbox",
        "menuitemradio",
        "option",
        "progressbar",
        "radio",
        "scrollbar",
        "searchbox",
        "separator",
        "slider",
        "spinbutton",
        "switch",
        "tab",
        "tabpanel",
        "textbox",
        "treeitem",
        "combobox",
        "grid",
        "listbox",
        "menu",
        "menubar",
        "radiogroup",
        "tablist",
        "tree",
        "treegrid",
        "application",
        "article",
        "blockquote",
        "caption",
        "cell",
        "code",
        "columnheader",
        "definition",
        "deletion",
        "directory",
        "document",
        "emphasis",
        "feed",
        "figure",
        "generic",
        "group",
        "heading",
        "img",
        "insertion",
        "list",
        "listitem",
        "math",
        "meter",
        "note",
        "paragraph",
        "row",
        "rowgroup",
        "rowheader",
        "strong",
        "subscript",
        "superscript",
        "table",
        "term",
        "time",
        "toolbar",
        "tooltip",
        "banner",
        "complementary",
        "contentinfo",
        "form",
        "main",
        "navigation",
        "region",
        "search",
        "alert",
        "log",
        "marquee",
        "status",
        "timer",
        "alertdialog",
        "dialog",
        "none",
        "presentation"
      ]
    },
    "contrastPair": {
      "type": "object",
      "properties": {
        "foreground": {
          "$ref": "#/$defs/tokenRef"
        },
        "background": {
          "$ref": "#/$defs/tokenRef"
        },
        "level": {
          "default": "AA",
          "type": "string",
          "enum": [
            "AA",
            "AAA"
          ]
        },
        "large": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "foreground",
        "background"
      ],
      "additionalProperties": false
    },
    "keyboardRule": {
      "type": "object",
      "properties": {
        "keys": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/keyChord"
          },
          "description": "Key chords: KeyboardEvent.key names (Escape, Enter, ' ' or Space, ArrowDown, Tab, Home, End), optionally behind Shift+/Control+/Alt+/Meta+ ('Shift+Tab', 'Control+a', 'Control+Home'), or a-z for typeahead."
        },
        "action": {
          "type": "string",
          "description": "What happens, in one sentence, from the APG pattern."
        },
        "when": {
          "description": "Focus location or state the rule applies in, e.g. 'focus on trigger', 'menu open'.",
          "type": "string"
        },
        "from": {
          "default": "inside",
          "description": "Where focus is before the key is pressed, for the keyboard gate: the element with aria-haspopup/aria-expanded (trigger), the first/last focusable inside the component, anywhere inside, or wherever it is.",
          "type": "string",
          "enum": [
            "trigger",
            "first",
            "last",
            "inside",
            "any"
          ]
        },
        "expect": {
          "default": "manual",
          "description": "Machine-checkable outcome the keyboard gate asserts after the key: the component's role element disappears/appears, focus moves as named, aria-expanded/aria-checked flips (toggles) or the focused item becomes checked/selected (selects). `manual` means the rule is documented but not auto-tested.",
          "type": "string",
          "enum": [
            "closes",
            "opens",
            "focus-next",
            "focus-prev",
            "focus-first",
            "focus-last",
            "focus-wraps-to-first",
            "focus-wraps-to-last",
            "focus-trigger",
            "focus-unchanged",
            "toggles",
            "selects",
            "manual"
          ]
        },
        "source": {
          "description": "Set by the parser: the extension doc that added this item, e.g. extensions/Button.analytics.md. Never authored.",
          "type": "string"
        }
      },
      "required": [
        "keys",
        "action"
      ],
      "additionalProperties": false
    },
    "keyChord": {
      "type": "string",
      "pattern": "^((Shift|Control|Alt|Meta)\\+)*(Escape|Enter| |Space|Tab|Backspace|Delete|Home|End|PageUp|PageDown|ArrowUp|ArrowDown|ArrowLeft|ArrowRight|F([1-9]|1[0-2])|\\*|,|a-z|[a-z0-9])$",
      "description": "A KeyboardEvent.key name, optionally behind Shift+/Control+/Alt+/Meta+ modifiers: Escape, Enter, ' ' (or Space), Tab, Backspace, Delete, Home, End, PageUp, PageDown, the four arrows, F1-F12, *, a comma, a lowercase letter or digit, or a-z for a typeahead range."
    },
    "behaviorScenario": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "kebab-case; becomes the test name."
        },
        "description": {
          "description": "Why this scenario exists, when the name is not enough.",
          "type": "string"
        },
        "given": {
          "description": "Props to render with (prop name -> value), over the Default story's args. Omit for defaults.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "when": {
          "description": "Exactly one interaction: { click: <part> }, { key: <keyChord> } pressed on the primary part, { type: <text> } into the primary part, { focus: <part> }, { blur: true }, { set: { <prop>: <value> } } (a controlled prop change, applied as a re-render), { hover: <part> }. Omit for a pure render assertion.",
          "$ref": "#/$defs/whenClause"
        },
        "then": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/thenClause"
          },
          "description": "Assertions, one object each, each with optional platforms: [<platformId>] to narrow just itself: { event, with? } or { event, fired: false }; { state: checked|expanded|selected|disabled|invalid|pressed|open, is: true|false|'mixed' }; { focusable: <bool> }; { renders: <bool> }; { focused: <part>|none|moved|unchanged }; { text: <text> }; { copy: <copy key> }; { role: <role> }; { name: true } (non-empty) or { name: <exact accessible name> }; { attribute: <name>, is: <string>|<bool>|null, on?: <part> } (null asserts the attribute is absent)."
        },
        "platforms": {
          "description": "Restrict to these platforms (default: all).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/platformId"
          }
        },
        "derived": {
          "description": "Set by the parser on scenarios it derives from the schema (generated/components.json behaviorDerived). Never authored.",
          "type": "boolean"
        },
        "source": {
          "description": "Set by the parser: the extension doc that added this item, e.g. extensions/Button.analytics.md. Never authored.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "then"
      ],
      "additionalProperties": false
    },
    "whenClause": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "click": {
              "type": "string"
            }
          },
          "required": [
            "click"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "key": {
              "$ref": "#/$defs/keyChord"
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "focus": {
              "type": "string"
            }
          },
          "required": [
            "focus"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "blur": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "blur"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "set": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "set"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "hover": {
              "type": "string"
            }
          },
          "required": [
            "hover"
          ],
          "additionalProperties": false
        }
      ]
    },
    "thenClause": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string"
            },
            "with": {},
            "platforms": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/platformId"
              }
            }
          },
          "required": [
            "event"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "string"
            },
            "fired": {
              "type": "boolean",
              "const": false
            },
            "platforms": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/platformId"
              }
            }
          },
          "required": [
            "event",
            "fired"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "checked",
                "expanded",
                "selected",
                "disabled",
                "invalid",
                "pressed",
                "open"
              ]
            },
            "is": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "const": "mixed"
                }
              ]
            },
            "platforms": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/platformId"
              }
            }
          },
          "required": [
            "state",
            "is"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "focusable": {
              "type": "boolean"
            },
            "platforms": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/platformId"
              }
            }
          },
          "required": [
            "focusable"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "renders": {
              "type": "boolean"
            },
            "platforms": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/platformId"
              }
            }
          },
          "required": [
            "renders"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "focused": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "none",
                    "moved",
                    "unchanged"
                  ]
                },
                {
                  "type": "string"
                }
              ]
            },
            "platforms": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/platformId"
              }
            }
          },
          "required": [
            "focused"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "platforms": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/platformId"
              }
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "copy": {
              "type": "string"
            },
            "platforms": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/platformId"
              }
            }
          },
          "required": [
            "copy"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "role": {
              "type": "string"
            },
            "platforms": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/platformId"
              }
            }
          },
          "required": [
            "role"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "anyOf": [
                {
                  "type": "boolean",
                  "const": true
                },
                {
                  "type": "string"
                }
              ]
            },
            "platforms": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/platformId"
              }
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "attribute": {
              "type": "string"
            },
            "is": {
              "type": [
                "string",
                "boolean",
                "null"
              ]
            },
            "on": {
              "type": "string"
            },
            "platforms": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/platformId"
              }
            }
          },
          "required": [
            "attribute",
            "is"
          ],
          "additionalProperties": false
        }
      ]
    },
    "platformNotes": {
      "type": "object",
      "properties": {
        "element": {
          "type": "string"
        },
        "tag": {
          "description": "The Lit custom element tag, e.g. ds-button. Required in a platforms.lit block unless supported is false.",
          "type": "string"
