{
  "name": "@design-schema/lit",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<owner>/design-schema.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6008 --no-open",
    "build-storybook": "storybook build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "lit": "^3.2.0"
  },
  "dependencies": {
    "@design-schema/tokens": "workspace:^"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.3.0",
    "@storybook/addon-essentials": "^8.3.0",
    "@storybook/web-components": "^8.3.0",
    "@storybook/web-components-vite": "^8.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@vitest/browser": "^3.2.7",
    "lit": "^3.2.0",
    "playwright": "^1.63.0",
    "storybook": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
