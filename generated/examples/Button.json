      },
      "snippets": {
        "react": "import { Button } from '@design-schema/react';\n\n<Button\n  label=\"Close\"\n  variant=\"ghost\"\n  iconOnly\n  leadingIcon={<svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1.5\">\n    <path d=\"M3 3l10 10M13 3L3 13\" />\n  </svg>}\n/>",
        "lit": "<ds-button label=\"Close\" variant=\"ghost\" icon-only>\n  <ds-icon slot=\"leading-icon\" name=\"close\"></ds-icon>\n</ds-button>",
        "rn": "import * as React from 'react';\nimport { Button, type ButtonVariant, Icon, type IconName, useTheme, type Tokens } from '@design-schema/rn';\n\nconst FOREGROUND_TOKEN: Record<ButtonVariant, keyof Tokens> = {\n  primary: 'colorActionPrimaryForeground',\n  secondary: 'colorActionSecondaryForeground',\n  ghost: 'colorActionGhostForeground',\n  danger: 'colorActionDangerForeground',\n};\n\nfunction GlyphIcon({\n  name,\n  variant = 'primary',\n  inverse = false,\n}: {\n  name: IconName;\n  variant?: ButtonVariant | undefined;\n  inverse?: boolean | undefined;\n}): React.JSX.Element {\n  const { tokens } = useTheme();\n  const color = variant === 'ghost' && inverse ? tokens.colorInverseLink : (tokens[FOREGROUND_TOKEN[variant]] as string);\n  return <Icon name={name} color={color} />;\n}\n\n<Button\n  label=\"Close\"\n  variant=\"ghost\"\n  iconOnly\n  leadingIcon={<GlyphIcon name=\"close\" variant=\"ghost\" />}\n/>",
        "swift": null
      },
      "stories": {
        "react": "IconOnly",
        "lit": "IconOnly",
        "rn": "IconOnly",
        "swift": null
      },
      "storyId": "button-react--icon-only",
      "sweep": null,
