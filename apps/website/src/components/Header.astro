---
/**
 * The site header (site/src/content/docs/process/website-plan.md, "Global chrome").
 *
 * `Landmark(role="banner")` → `Container(width="page")` → a `Stack` row with the logo link at the
 * start, the nav's links centred in the space after it, and the theme control at the end (header.css).
 *
 * The band is a plain `<div class="ds-site-header" data-mode="dark">` inside the Landmark, not a
 * class on the Landmark: generated components take no `className` (foundations/styling-and-overrides.md),
 * and the regen of 2026-09-16 that enforced it for Landmark is what cost the header its dark band
 * (process/website-audit.md). `data-mode` sits on the same element as the rules that read its
 * variables, so the header is dark on a light page too.
 *
 * Everything static lives here, rendered to HTML at build time; only the pieces that have state — the theme switcher and the mobile drawer — are the `HeaderNav`
 * island, so the links are in the document whether or not its JavaScript ever arrives.
 *
 * The desktop/mobile swap is a media query in ./header.css rather than a `matchMedia` in the island,
 * for the same reason: a breakpoint the browser already knows shouldn't wait on hydration to be
 * applied.
 */
import { Container, Landmark, Stack } from '@design-schema/react';
import { layoutBreakpointMd } from '@design-schema/tokens/calm-precise/light';

import HeaderNav from './HeaderNav';
import Logo from '../assets/logo.svg';
import { siteNav } from '../nav';
import { publishedThemes } from '../themes';
import './header.css';

const { top } = siteNav();
const themes = publishedThemes().map(({ id, title }) => ({ id, title }));

/**
 * The wordmark stays live text rather than being drawn into the logo asset: it is the accessible
 * name of the header's home link, and it is themed by the type tokens like any other text.
 *
 * The whole lockup is the home link (Tony's review, 2026-09-15 — there is no separate "Homepage" nav
 * entry any more), so the mark (job 504) sits inside the anchor, `aria-hidden`: the wordmark already
 * names the link, and the mark would only repeat it. That makes this a plain `<a>` rather than a
 * `Link`, which renders its `label` and nothing else; header.css gives it Link's focus ring.
 */
const WORDMARK = 'Design Schema';

/**
 * header.css writes `layout.breakpoint.md`'s value out, because a custom property cannot appear in
 * a media condition (foundations/layout.md, "Reading a breakpoint"). Nothing in CSS can check that
 * against the token, so the build does: move the token and this fails instead of the layout.
 */
const BREAKPOINT_MD_IN_CSS = '768px';
if (layoutBreakpointMd !== BREAKPOINT_MD_IN_CSS) {
  throw new Error(
    `layout.breakpoint.md is now ${layoutBreakpointMd}; update the @media condition in ` +
      `apps/website/src/components/header.css (and BREAKPOINT_MD_IN_CSS here) to match.`,
  );
}
---

<Landmark role="banner">
  <div class="ds-site-header" data-mode="dark">
    <Container width="page">
      <Stack direction="horizontal" align="center" gap="normal">
        <a class="ds-site-header__home" href="/">
          <Logo class="ds-site-header__mark" aria-hidden="true" focusable="false" />
          <span>{WORDMARK}</span>
        </a>
        <HeaderNav client:load items={top} themes={themes} current={Astro.url.pathname} />
      </Stack>
    </Container>
  </div>
</Landmark>
