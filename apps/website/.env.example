# Copy to apps/website/.env (gitignored) and fill in. Read by apps/website/compose.yaml.

# The tunnel's token: Cloudflare Zero Trust > Networks > Tunnels > your tunnel > install command, the part after --token.
TUNNEL_TOKEN=
# The local check port: http://127.0.0.1:8080 on this machine only, never the LAN or the internet.
HTTP_PORT=8080
# The public URL Astro builds canonical links from (its `site`); leave empty to build exactly as without it.
PUBLIC_SITE_URL=https://designschema.example.com
