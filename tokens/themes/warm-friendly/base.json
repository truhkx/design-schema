    "12": {
      "$value": "60px"
    },
    "16": {
      "$value": "80px"
    },
    "20": {
      "$value": "100px"
    },
    "sm": {
      "$value": "{space.2}"
    },
    "md": {
      "$value": "{space.3}"
    },
    "lg": {
      "$value": "{space.4}"
    }
  },
  "layout": {
    "$type": "dimension",
    "gutter": {
      "$description": "Horizontal page padding at each breakpoint.",
      "narrow": {
        "$value": "{space.4}"
      },
      "default": {
        "$value": "{space.6}"
      },
      "wide": {
        "$value": "{space.8}"
      }
    },
    "section": {
      "$description": "Vertical space between page sections (a Landmark, a heading group, a card row).",
      "sm": {
        "$value": "60px"
      },
      "md": {
        "$value": "90px"
      },
      "lg": {
        "$value": "120px"
      }
    },
    "gap": {
      "$description": "Gap between siblings in either direction \u2014 the presets Stack, Card and Container expose. Scaled by density and rhythm.",
      "none": {
        "$value": "{space.0}"
      },
      "tight": {
        "$value": "8px"
      },
      "normal": {
        "$value": "15px"
      },
      "loose": {
        "$value": "30px"
      },
      "section": {
        "$value": "60px"
      }
    },
    "inset": {
      "$description": "Padding presets surfaces expose (Box, Card): sm/md/lg map to the space aliases.",
      "none": {
        "$value": "{space.0}"
      },
      "sm": {
        "$value": "{space.sm}"
      },
      "md": {
        "$value": "{space.md}"
      },
      "lg": {
        "$value": "{space.lg}"
      },
      "xl": {
        "$value": "{space.8}"
      }
    },
    "maxWidth": {
      "$description": "Column widths. prose is a 65-character measure at the body size (px, so React Native can use it).",
      "prose": {
        "$value": "572px"
      },
      "content": {
        "$value": "1040px"
      },
      "page": {
        "$value": "1387px"
      }
    }
  },
