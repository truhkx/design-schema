# Dependencies
node_modules/

# Build outputs: everything below is recreated by `pnpm check`, `pnpm tokens`, `pnpm build` or a gate.
site/dist/
site/.astro/
apps/website/dist/
apps/website/.astro/
packages/*/dist/
packages/*/storybook-static/
packages/*/.modules-check/
apps/*/.expo/
site/src/content/docs/foundations/spec-sheet.md
generated/components.json
generated/nav.json
generated/themes.json
generated/examples/
generated/prompts/
generated/behavior/
generated/keyboard/
# Kept on purpose: generated/generate.lock.json (the hash CI checks), generated/gaps/ (what the docs left
# ambiguous), and generated/chromatic.json (the three hosted Storybook URLs — typed in by hand once, since a
# Chromatic project URL only exists after somebody creates the project; `pnpm chromatic:check` guards it).

# SwiftPM / Xcode build state (packages/swiftui, apps/ios-gallery)
.build/
.swiftpm/
*.xcodeproj/xcuserdata/
DerivedData/
# XcodeGen writes the gallery's project from apps/ios-gallery/project.yml on the macOS runner; the .yml is
# the reviewable source, the .xcodeproj is build state (apps/ios-gallery/project.yml explains why).
apps/ios-gallery/*.xcodeproj/

# Local state, logs, caches
logs/
mcp/.chroma/
test-results/
playwright-report/
*.log

# Scratch folders that are not part of the system
_to_delete/
_xfer/
Claude outputs/
.claude/
