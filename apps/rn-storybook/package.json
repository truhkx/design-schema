{
  "name": "rn-storybook",
  "version": "0.0.1",
  "private": true,
  "description": "On-device Storybook for @design-schema/rn (Expo SDK 51 + @storybook/react-native 8), for VoiceOver and TalkBack checks. The react-native-web Storybook on port 6009 stays the one the gates use.",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "storybook-generate": "sb-rn-get-stories",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@design-schema/rn": "workspace:*",
    "@design-schema/tokens": "workspace:*",
    "@gorhom/bottom-sheet": "^4.6.4",
    "@storybook/addon-ondevice-actions": "8.6.4",
    "@storybook/addon-ondevice-backgrounds": "8.6.4",
    "@storybook/addon-ondevice-controls": "8.6.4",
    "@storybook/react-native": "8.6.4",
    "expo": "~51.0.39",
    "expo-status-bar": "~1.12.1",
    "react": "^18.3.1",
    "react-native": "^0.74.7",
    "react-native-gesture-handler": "~2.16.2",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-svg": "15.15.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@storybook/manager-api": "^8.3.0",
    "@storybook/preview-api": "^8.3.0",
    "@storybook/react": "^8.3.0",
    "@types/react": "^18.3.0",
    "babel-preset-expo": "~11.0.15",
    "storybook": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
