{
  "name": "design-schema",
  "private": true,
  "version": "0.0.1",
  "description": "Documentation-first, schema-driven, cross-platform design system generator.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "themes": "node --import tsx tools/theme.ts && node tokens/build.mjs",
    "tokens": "node tokens/build.mjs",
    "parse": "node --import tsx tools/parse.ts",
    "schema": "node --import tsx tools/schema.ts",
    "check": "node --import tsx tools/theme.ts && node tokens/build.mjs && node --import tsx tools/schema.ts --check && node --import tsx tools/parse.ts && node --import tsx tools/check_contrast.ts && node --import tsx tools/spec_sheet.ts",
    "test:tools": "vitest run",
    "typecheck:tools": "tsc -p tools",
    "docs": "pnpm --filter site dev",
    "build": "pnpm check && pnpm tokens && pnpm lint:literals && pnpm generate:check && pnpm --filter site build",
    "storybook": "pnpm --filter storybook-root storybook",
    "typecheck": "pnpm -r --no-bail --filter \"@design-schema/*\" typecheck",
    "mcp:index": "node --disable-warning=ExperimentalWarning --import tsx mcp/index.ts",
    "mcp:smoke": "node --disable-warning=ExperimentalWarning --import tsx mcp/smoke.ts",
    "mcp": "node --disable-warning=ExperimentalWarning --import tsx mcp/server.ts",
    "gates": "node --import tsx tools/checks.ts --platform web && node --import tsx tools/checks.ts --platform lit && node --import tsx tools/checks.ts --platform rn",
    "lint:literals": "node --import tsx tools/lint_literals.ts",
    "generate": "node --import tsx tools/generate.ts",
    "generate:check": "node --import tsx tools/generate.ts --check",
    "gates:keyboard": "node --import tsx tools/keyboard_tests.ts && playwright test --project=keyboard-web --project=keyboard-lit",
    "gates:axe": "playwright test --project=axe-web --project=axe-lit --project=axe-rn",
    "gates:browser": "node --import tsx tools/keyboard_tests.ts && playwright test",
    "gates:behavior": "node --import tsx tools/behavior_tests.ts && pnpm --filter @design-schema/react run test generated/behavior && pnpm --filter @design-schema/lit run test generated/behavior && pnpm --filter @design-schema/rn run test generated/behavior",
    "gates:behavior:check": "node --import tsx tools/behavior_tests.ts --check",
    "spec-sheet": "node --import tsx tools/spec_sheet.ts",
    "icons": "node --import tsx tools/icon-paths.ts",
    "icons:check": "node --import tsx tools/icon-paths.ts --check",
    "icons:snapshots": "node --import tsx tools/icon-snapshots.ts",
    "icons:snapshots:check": "node --import tsx tools/icon-snapshots.ts --check",
    "build:packages": "pnpm -r --filter \"@design-schema/*\" run build",
    "release:check": "pnpm build:packages && pnpm -r --filter \"@design-schema/*\" exec publint && pnpm -r --filter \"@design-schema/*\" exec attw --pack && pnpm -r --filter \"@design-schema/*\" exec npm pack --dry-run",
    "currency": "node tools/currency.ts",
    "storybook:device": "pnpm --filter rn-storybook start"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.10.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "onnxruntime-node": "^1.29.0",
    "publint": "^0.3.24",
    "style-dictionary": "^4.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@bundled-es-modules/glob",
      "esbuild",
      "onnxruntime-node",
      "playwright",
      "sharp",
      "style-dictionary"
    ]
  }
}
