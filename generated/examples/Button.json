        "lit": "<div\n  style=\"background: var(--color-inverse-surface); padding: var(--space-md); border-radius: var(--radius-md);\"\n>\n  <ds-button label=\"Dismiss\" variant=\"ghost\" inverse></ds-button>\n</div>",
        "rn": "import * as React from 'react';\nimport { View } from 'react-native';\nimport { Button, useTheme } from '@design-schema/rn';\n\nfunction InverseSurface({ children }: { children: React.ReactNode }): React.JSX.Element {\n  const { tokens } = useTheme();\n  return (\n    <View style={{ backgroundColor: tokens.colorInverseSurface, padding: tokens.spaceMd, borderRadius: tokens.radiusMd }}>\n      {children}\n    </View>\n  );\n}\n\n<InverseSurface>\n  <Button label=\"Learn more\" variant=\"ghost\" inverse />\n</InverseSurface>",
