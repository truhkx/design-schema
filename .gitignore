# Dependencies
node_modules/

# Build outputs are committed for now (2026-09-14), so the repository carries the current generation of the
# design system: generated/ (parsed schema, prompts, behavior and keyboard tests, examples, nav, themes), the
# spec sheet, packages/*/dist, the three Storybook builds, and both site builds. Every one is still recreated
# by `pnpm check`, `pnpm tokens`, `pnpm build` or a gate, so a regeneration shows up as a reviewable diff.
# Only caches and machine-local state stay ignored.
site/.astro/
apps/website/.astro/
packages/*/.modules-check/
apps/*/.expo/

# SwiftPM / Xcode build state (packages/swiftui, apps/ios-gallery)
.build/
.swiftpm/
*.xcodeproj/xcuserdata/
DerivedData/
# XcodeGen writes the gallery's project from apps/ios-gallery/project.yml on the macOS runner; the .yml is
# the reviewable source, the .xcodeproj is build state (apps/ios-gallery/project.yml explains why).
apps/ios-gallery/*.xcodeproj/

# Local state, logs, caches
logs/
mcp/.chroma/
test-results/
playwright-report/
*.log

# Scratch folders that are not part of the system
_to_delete/
_xfer/
Claude outputs/
.claude/
