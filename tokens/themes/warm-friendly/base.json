  "border": {
    "width": {
      "$type": "dimension",
      "thin": {
        "$value": "1px"
      },
      "focus": {
        "$value": "2px"
      }
    }
  },
  "opacity": {
    "$type": "number",
    "disabled": {
      "$value": 0.5
    }
  },
  "layer": {
    "$type": "number",
    "base": {
      "$value": 0
    },
    "raised": {
      "$value": 1
    },
    "dropdown": {
      "$value": 100
    },
    "sheet": {
      "$value": 200
    },
    "dialog": {
      "$value": 300
    },
    "toast": {
      "$value": 400
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "120ms"
      },
      "base": {
        "$value": "200ms"
      },
      "loop": {
        "$value": "800ms"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      },
      "exit": {
        "$value": [
          0.4,
          0,
          1,
          1
        ]
      }
    }
  }
